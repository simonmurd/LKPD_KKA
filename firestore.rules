rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test collection for client connectivity verification
    match /test/{docId} {
      allow read, write: if true;
    }

    // Student profile documents
    match /students/{studentId} {
      allow read: if true;
      allow write: if request.resource.data.id != null 
                    && request.resource.data.name != null 
                    && request.resource.data.className != null;
    }

    // Exam Results & CBT Submissions
    match /exam_results/{resultId} {
      allow read: if true;
      allow create, update: if request.resource.data.studentId != null 
                            && request.resource.data.moduleId != null
                            && request.resource.data.mcScore != null;
      allow delete: if false;
    }

    // Real-Time Live Chat Messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.senderId != null 
                    && request.resource.data.content != null
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() < 2000;
      allow update, delete: if false;
    }

    // Presence & Online status
    match /presences/{presenceId} {
      allow read: if true;
      allow write: if request.resource.data.id != null 
                    && request.resource.data.name != null;
    }

    // Teacher Assignments
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if request.resource.data.title != null;
      allow delete: if true;
    }

    // Student Submissions & Grades
    match /submissions/{subId} {
      allow read: if true;
      allow write: if request.resource.data.studentId != null 
                    && request.resource.data.assignmentId != null;
    }

    // Spreadsheet Scores Matrix (Pak Simon's Format)
    match /spreadsheet_scores/{classId} {
      allow read, write: if true;
    }
  }
}
